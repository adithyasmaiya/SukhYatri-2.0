# ==============================================================================
# SukhYatri 2.0 — Production & Development Backend Environment Variables
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Populate with genuine production credentials before deploying.
# 3. NEVER commit the live .env file to source control.
# ==============================================================================

# Core Runtime Environment
# Values: 'development' | 'production' | 'test'
NODE_ENV=production
PORT=5000

# Database Connectivity (MongoDB Atlas connection string)
# Format: mongodb+srv://<db_user>:<db_password>@<cluster-url>/sukhyatri?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://prod_user:yourStrongDatabasePassword@cluster0.abcde.mongodb.net/sukhyatri?retryWrites=true&w=majority

# JWT Authentication Security
# Generate with: openssl rand -base64 64
JWT_SECRET=generate_a_64_byte_cryptographically_secure_random_string_here
JWT_EXPIRES_IN=7d

# Domain & CORS Configuration
# Must match your actual production frontend origin (NO wildcard '*' allowed in production)
FRONTEND_URL=https://www.sukhyatri.com
CORS_ORIGIN=https://www.sukhyatri.com
API_URL=https://api.sukhyatri.com/api

# Initial Production Administrator Account (Provisions on first clean run)
ADMIN_NAME="SukhYatri Chief Concierge"
ADMIN_EMAIL=concierge.admin@sukhyatri.com
ADMIN_PASSWORD=change_this_to_a_minimum_16_char_secure_admin_password

# Razorpay Payment Gateway Configuration
# Keep in Test Mode (rzp_test_...) during staging; switch to Live Mode (rzp_live_...) only for production launch.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_webhook_secret_from_razorpay_dashboard

# Transactional Email Notification Service (Resend)
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=re_your_verified_api_key_here
# If your custom domain isn't verified yet on Resend, test with: onboarding@resend.dev
# Once your domain (e.g. sukhyatri.com) is verified, set to: concierge@sukhyatri.com
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME="SukhYatri Concierge"

# Optional SMTP Settings (Only required if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_smtp_password_here

# Public Web Application Base URL (Used for generating email action links and reset tokens)
APP_URL=https://www.sukhyatri.com
