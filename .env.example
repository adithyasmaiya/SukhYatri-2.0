# ==============================================================================
# SukhYatri 2.0 — Production Frontend Environment Variables (Vite)
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# In Vite applications, only variables prefixed with `VITE_` are exposed to
# the browser bundle. NEVER put database credentials, JWT secrets, Razorpay secrets,
# or email provider API keys into this file!
# ==============================================================================

# Backend API Base URL
# For local development: http://localhost:5000/api
# For production deployment: https://api.sukhyatri.com/api
VITE_API_URL=https://api.sukhyatri.com/api

# Public Razorpay Key ID (Client-safe publishable key)
# For local/test staging: rzp_test_yourKeyIdHere
# For live production: rzp_live_yourKeyIdHere
VITE_RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
